# Numeric uid/gid the container process runs as. Must match the owner of
# /etc/nestor/config.yaml on the host: `id -u nestor` / `id -g nestor`.
NESTOR_UID=
NESTOR_GID=

# Existing docker network the reverse proxy runs on; nestor joins it and
# publishes no host port at all.
NESTOR_PROXY_NETWORK=

# Hostname nginx-proxy serves the daemon on. Must be its own name, never the
# one another container already claims — nginx-proxy merges containers that
# share a VIRTUAL_HOST into one load-balanced upstream.
NESTOR_VIRTUAL_HOST=
